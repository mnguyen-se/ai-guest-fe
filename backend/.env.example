# ===== Supabase (miễn phí - https://supabase.com) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ===== FRED - dữ liệu vĩ mô (miễn phí - https://fred.stlouisfed.org/docs/api/api_key.html) =====
FRED_API_KEY=your-fred-api-key

# ===== Gemini API - lớp AI phân tích (miễn phí free-tier - https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=your-gemini-api-key

# ===== Reddit (TÙY CHỌN, miễn phí - https://www.reddit.com/prefs/apps) =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ===== CORS: domain frontend sau khi deploy lên Vercel =====
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
